<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.Developer.Core</RootNamespace>
    <AssemblyName>Nexus.Developer.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Contracts-only reference to Layer 06 Product Core (CHG-20260827-002), the same pattern
      already established for DEVELOPER -> EXPERIENCE (CHANGE_REPORT_v2.1 #10). This is NOT a
      product domain assembly reference - Nexus.ProductCore.Contracts holds only interfaces
      (IScopeKindRegistry) and small value types (ScopeKind, WellKnownScopeKinds), no
      Workspace/Project/Subproject domain classes. Restored from the local file feed
      (C:\Personal\LocalNuGet) since GitHub Packages is unreachable from this device - see
      nuget.config's "local" source.
    -->
    <PackageReference Include="Nexus.ProductCore.Contracts" Version="0.1.0-*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bootstrap-safe shared DevelopmentControl contract assembly (SP1-WAVE-04 Lane A): the
      pure zero-IO DevelopmentControl value contracts were physically extracted from this
      project's DevelopmentControl folder into Nexus.DevelopmentControl.Contracts so Forge /
      Foundation tools can bundle them with no Excel/EF/DI/runtime and no Nexus.Developer.Core
      dependency. The behavioral implementations (guarded store, atomic-write coordinator,
      named mutex/semaphore write locks) remain in this project.
    -->
    <ProjectReference Include="..\Nexus.DevelopmentControl.Contracts\Nexus.DevelopmentControl.Contracts.csproj" />
  </ItemGroup>

</Project>
